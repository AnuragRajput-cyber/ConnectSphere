pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  environment {
    BACKEND_REPO_URL = 'https://github.com/AnuragRajput-cyber/ConnectSphere.git'
    FRONTEND_REPO_URL = 'https://github.com/AnuragRajput-cyber/ConnectSphereFrontend.git'
    BACKEND_BRANCH = 'main'
    FRONTEND_BRANCH = 'main'
    COMPOSE_PROJECT_NAME = 'connectsphere'
    COMPOSE_FILE = 'docker-compose.prod.yml'
    DEPLOY_ENV_FILE = '/run/secrets/connectsphere.env'
    CI_NETWORK = 'connectsphere-ci'
    CI_MYSQL_CONTAINER = 'connectsphere-ci-mysql'
    CI_MYSQL_PASSWORD = 'root123'
    SONAR_HOST_URL = 'http://host.docker.internal:9000'
    SONAR_TOKEN_CREDENTIAL_ID = 'sonarqube-token'
    SONAR_SCANNER_JAVA_OPTS = '-Xmx512m'
  }

  stages {
    stage('Checkout Backend') {
      steps {
        git branch: "${BACKEND_BRANCH}", url: "${BACKEND_REPO_URL}"
      }
    }

    stage('Checkout Frontend Repo Into Expected Folder') {
      steps {
        dir('connectsphere-web') {
          deleteDir()
          git branch: "${FRONTEND_BRANCH}", url: "${FRONTEND_REPO_URL}"
        }
      }
    }

    stage('Validate Production Env File') {
      steps {
        sh '''
          test -f ${DEPLOY_ENV_FILE}
          test -s ${DEPLOY_ENV_FILE}
        '''
      }
    }

    stage('Start CI Database') {
      steps {
        sh '''
          docker rm -f ${CI_MYSQL_CONTAINER} >/dev/null 2>&1 || true
          docker network create ${CI_NETWORK} >/dev/null 2>&1 || true
          docker network connect ${CI_NETWORK} connectsphere-jenkins >/dev/null 2>&1 || true

          docker run -d --name ${CI_MYSQL_CONTAINER} \
            --network ${CI_NETWORK} \
            -e MYSQL_ROOT_PASSWORD=${CI_MYSQL_PASSWORD} \
            mysql:8.4

          for i in $(seq 1 60); do
            if docker exec ${CI_MYSQL_CONTAINER} mysqladmin ping -uroot -p${CI_MYSQL_PASSWORD} --silent; then
              exit 0
            fi
            sleep 2
          done

          docker logs ${CI_MYSQL_CONTAINER}
          exit 1
        '''
      }
    }

    stage('Backend Tests') {
      steps {
        sh '''
          MYSQL_HOST=${CI_MYSQL_CONTAINER} \
          MYSQL_PORT=3306 \
          MYSQL_USERNAME=root \
          MYSQL_PASSWORD=${CI_MYSQL_PASSWORD} \
          MAIL_HEALTH_ENABLED=false \
          REDIS_HEALTH_ENABLED=false \
          RABBIT_HEALTH_ENABLED=false \
          ELASTICSEARCH_HEALTH_ENABLED=false \
          mvn test
        '''
      }
    }

    stage('Frontend Build') {
      steps {
        dir('connectsphere-web') {
          sh 'npm ci --prefer-offline'
          sh 'npm test -- --watch=false'
          sh 'npm run build'
        }
      }
    }

    stage('SonarQube Analysis') {
      steps {
        withCredentials([string(credentialsId: "${SONAR_TOKEN_CREDENTIAL_ID}", variable: 'SONAR_TOKEN')]) {
          sh '''
            sonar-scanner \
              -Dsonar.host.url=${SONAR_HOST_URL} \
              -Dsonar.token=${SONAR_TOKEN}
          '''
        }
      }
    }

    stage('SonarQube Quality Gate') {
      steps {
        withCredentials([string(credentialsId: "${SONAR_TOKEN_CREDENTIAL_ID}", variable: 'SONAR_TOKEN')]) {
          timeout(time: 10, unit: 'MINUTES') {
            sh '''node <<'NODE'
const fs = require('fs');

const reportPath = '.scannerwork/report-task.txt';
if (!fs.existsSync(reportPath)) {
  throw new Error(`Missing ${reportPath}. Sonar analysis did not produce a task report.`);
}

const props = Object.fromEntries(
  fs.readFileSync(reportPath, 'utf8')
    .split(/\\r?\\n/)
    .filter((line) => line && line.includes('='))
    .map((line) => {
      const index = line.indexOf('=');
      return [line.slice(0, index), line.slice(index + 1)];
    })
);

const host = process.env.SONAR_HOST_URL;
const token = process.env.SONAR_TOKEN;
const auth = Buffer.from(`${token}:`).toString('base64');

async function getJson(path) {
  const response = await fetch(`${host}${path}`, {
    headers: { Authorization: `Basic ${auth}` },
  });
  if (!response.ok) {
    throw new Error(`${path} returned ${response.status}`);
  }
  return response.json();
}

async function waitForCeTask(taskId) {
  for (let attempt = 0; attempt < 60; attempt++) {
    const payload = await getJson(`/api/ce/task?id=${encodeURIComponent(taskId)}`);
    const task = payload.task;
    if (task.status === 'SUCCESS') {
      return task.analysisId;
    }
    if (['FAILED', 'CANCELED'].includes(task.status)) {
      throw new Error(`SonarQube background task ${task.status}`);
    }
    await new Promise((resolve) => setTimeout(resolve, 5000));
  }
  throw new Error('Timed out waiting for SonarQube background task.');
}

async function main() {
  const analysisId = await waitForCeTask(props.ceTaskId);
  const gate = await getJson(`/api/qualitygates/project_status?analysisId=${encodeURIComponent(analysisId)}`);
  const status = gate.projectStatus?.status;
  console.log(`SonarQube Quality Gate: ${status}`);
  if (status !== 'OK') {
    const failed = (gate.projectStatus?.conditions || [])
      .filter((condition) => condition.status !== 'OK')
      .map((condition) => `${condition.metricKey}: ${condition.actualValue} ${condition.comparator} ${condition.errorThreshold}`)
      .join('\\n');
    throw new Error(`Quality Gate failed${failed ? `\\n${failed}` : ''}`);
  }
}

main().catch((error) => {
  console.error(error.message || error);
  process.exit(1);
});
NODE
'''
          }
        }
      }
    }

    stage('Compose Validation') {
      steps {
        sh 'docker compose --env-file ${DEPLOY_ENV_FILE} -f ${COMPOSE_FILE} config >/tmp/connectsphere-compose-check.txt'
      }
    }

    stage('Build Images') {
      steps {
        sh 'docker compose --env-file ${DEPLOY_ENV_FILE} -f ${COMPOSE_FILE} build'
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          for container in \
            connectsphere-mysql \
            connectsphere-redis \
            connectsphere-rabbitmq \
            connectsphere-elasticsearch; do
            docker rm -f "$container" >/dev/null 2>&1 || true
          done

          docker compose --env-file ${DEPLOY_ENV_FILE} -f ${COMPOSE_FILE} up -d
        '''
      }
    }

    stage('Smoke Checks') {
      steps {
        sh '''
          for i in $(seq 1 30); do
            if docker run --rm --network ${COMPOSE_PROJECT_NAME}_connectsphere curlimages/curl:8.11.1 \
              -fsS http://frontend >/tmp/connectsphere-frontend.html \
              && docker run --rm --network ${COMPOSE_PROJECT_NAME}_connectsphere curlimages/curl:8.11.1 \
              -fsS http://api-gateway:8080/actuator/health >/tmp/connectsphere-gateway-health.json; then
              exit 0
            fi
            sleep 2
          done

          docker compose --env-file ${DEPLOY_ENV_FILE} -f ${COMPOSE_FILE} ps
          docker logs --tail=80 connectsphere-frontend-1 || true
          docker logs --tail=120 connectsphere-api-gateway-1 || true
          exit 1
        '''
      }
    }
  }

  post {
    always {
      sh 'docker rm -f ${CI_MYSQL_CONTAINER} >/dev/null 2>&1 || true'
      archiveArtifacts artifacts: 'docs/*.md,docs/*.html,docs/*.pdf,deployment/**/*.yml,deployment/**/*.sh', allowEmptyArchive: true
    }
  }
}
