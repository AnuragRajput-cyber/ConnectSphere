pipeline {
  agent any

  environment {
    BACKEND_REPO_URL = 'https://github.com/AnuragRajput-cyber/ConnectSphere.git'
    FRONTEND_REPO_URL = 'https://github.com/AnuragRajput-cyber/ConnectSphereFrontend.git'
    BACKEND_BRANCH = 'main'
    FRONTEND_BRANCH = 'main'
    COMPOSE_PROJECT_NAME = 'connectsphere'
    COMPOSE_FILE = 'docker-compose.prod.yml'
    DEPLOY_ENV_FILE = '/run/secrets/connectsphere.env'
    CI_MYSQL_CONTAINER = 'connectsphere-ci-mysql'
    CI_MYSQL_PORT = '3307'
    CI_MYSQL_PASSWORD = 'root123'
  }

  stages {
    stage('Clean Workspace') {
      steps {
        deleteDir()
      }
    }

    stage('Checkout Backend') {
      steps {
        git branch: "${BACKEND_BRANCH}", url: "${BACKEND_REPO_URL}"
      }
    }

    stage('Checkout Frontend Repo Into Expected Folder') {
      steps {
        dir('connectsphere-web') {
          deleteDir()
          git branch: "${FRONTEND_BRANCH}", url: "${FRONTEND_REPO_URL}"
        }
      }
    }

    stage('Validate Production Env File') {
      steps {
        sh '''
          test -f ${DEPLOY_ENV_FILE}
          test -s ${DEPLOY_ENV_FILE}
        '''
      }
    }

    stage('Start CI Database') {
      steps {
        sh '''
          docker rm -f ${CI_MYSQL_CONTAINER} >/dev/null 2>&1 || true
          docker run -d --name ${CI_MYSQL_CONTAINER} \
            -e MYSQL_ROOT_PASSWORD=${CI_MYSQL_PASSWORD} \
            -p ${CI_MYSQL_PORT}:3306 \
            mysql:8.4

          for i in $(seq 1 60); do
            if docker exec ${CI_MYSQL_CONTAINER} mysqladmin ping -uroot -p${CI_MYSQL_PASSWORD} --silent; then
              exit 0
            fi
            sleep 2
          done

          docker logs ${CI_MYSQL_CONTAINER}
          exit 1
        '''
      }
    }

    stage('Backend Tests') {
      steps {
        sh '''
          MYSQL_HOST=host.docker.internal \
          MYSQL_PORT=${CI_MYSQL_PORT} \
          MYSQL_USERNAME=root \
          MYSQL_PASSWORD=${CI_MYSQL_PASSWORD} \
          MAIL_HEALTH_ENABLED=false \
          REDIS_HEALTH_ENABLED=false \
          RABBIT_HEALTH_ENABLED=false \
          ELASTICSEARCH_HEALTH_ENABLED=false \
          mvn test
        '''
      }
    }

    stage('Frontend Build') {
      steps {
        dir('connectsphere-web') {
          sh 'npm ci'
          sh 'npm test -- --watch=false'
          sh 'npm run build'
        }
      }
    }

    stage('Compose Validation') {
      steps {
        sh 'docker compose --env-file ${DEPLOY_ENV_FILE} -f ${COMPOSE_FILE} config >/tmp/connectsphere-compose-check.txt'
      }
    }

    stage('Build Images') {
      steps {
        sh 'docker compose --env-file ${DEPLOY_ENV_FILE} -f ${COMPOSE_FILE} build'
      }
    }

    stage('Deploy') {
      steps {
        sh '''
          for container in \
            connectsphere-mysql \
            connectsphere-redis \
            connectsphere-rabbitmq \
            connectsphere-elasticsearch; do
            docker rm -f "$container" >/dev/null 2>&1 || true
          done

          docker compose --env-file ${DEPLOY_ENV_FILE} -f ${COMPOSE_FILE} up -d
        '''
      }
    }

    stage('Smoke Checks') {
      steps {
        sh 'curl -fsS http://127.0.0.1:8088 >/tmp/connectsphere-frontend.html'
      }
    }
  }

  post {
    always {
      sh 'docker rm -f ${CI_MYSQL_CONTAINER} >/dev/null 2>&1 || true'
      archiveArtifacts artifacts: 'docs/*.md,docs/*.html,docs/*.pdf,deployment/**/*.yml,deployment/**/*.sh', allowEmptyArchive: true
    }
  }
}
