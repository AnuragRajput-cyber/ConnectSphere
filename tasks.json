{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run All Services",
      "dependsOrder": "parallel",
      "dependsOn": [
        "service-registry",
        "api-gateway",
        "auth-service",
        "chat-service",
        "comment-service",
        "follow-service",
        "like-service",
        "media-service",
        "notification-service",
        "post-service",
        "search-service"
      ]
    },

    {
      "label": "service-registry",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/service-registry" },
      "isBackground": true,
      "presentation": { "panel": "dedicated", "group": "microservices" }
    },

